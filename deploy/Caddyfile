# /etc/caddy/Caddyfile ga qo'shiladi (Farm Bot bloki o'zgarmaydi)
{
	servers {
		# Cloudflare orqasida: haqiqiy IP faqat Cloudflare IP'laridan ishoniladi
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP
	}
}

neyromed.uz, www.neyromed.uz {
	encode zstd gzip
	@www host www.neyromed.uz
	redir @www https://neyromed.uz{uri} permanent

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Ichki endpointlar tashqaridan yopiq
	@internal path /api/revalidate /api/revalidate/*
	respond @internal 404

	# Media: immutable kesh, faqat statik fayl (skript bajarilmaydi)
	handle /media/* {
		root * /var/lib/docker/volumes/neyromed_media/_data
		uri strip_prefix /media
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; sandbox"
		file_server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8100 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy 127.0.0.1:3100
	}
}
